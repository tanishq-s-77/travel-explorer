# ==============================================================================
# Travel Explorer Environment Variables Guide
# ==============================================================================
# The application reads environment variables from two files:
# 1. Backend:  server/.env
# 2. Frontend: client/.env
#
# Below is the exact format and description for each file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND VARIABLES (Place in server/.env)
# ------------------------------------------------------------------------------
PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
# Example: https://xyzexampleproject.supabase.co
SUPABASE_URL=your_supabase_project_url_here

# Supabase Secret Service Role Key (recommended for backend server operations)
# Or your Supabase Anon Key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenWeatherMap API Key (from https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Unsplash API Access Key (from https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here


# ------------------------------------------------------------------------------
# 2. FRONTEND VARIABLES (Place in client/.env)
# ------------------------------------------------------------------------------
# Points to the local Express backend server
VITE_API_URL=http://localhost:5000/api

# Supabase Project URL (same as backend)
VITE_SUPABASE_URL=your_supabase_project_url_here

# Supabase Public Anon Key (for browser authentication)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
